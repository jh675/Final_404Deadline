<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.project.milestone.mapper.MilestoneMapper">

	<resultMap type="MilestoneIssueVO" id="MilestoneIssueResultMap">
		<id     column="id"           property="id"/>
		<result column="milestone_id" property="milestoneId"/>
		<result column="issue_id"     property="issueId"/>
		<result column="name"         property="name"/>
		<collection property="events"
					ofType="MilestoneTimelineVO"
					resultMap="MilestoneTimelineResultMap"/>
	</resultMap>
	<resultMap type="MilestoneTimelineVO" id="MilestoneTimelineResultMap">
		<id column="timeline_id" property="id" />
		<result column="contents" property="contents" />
		<result column="entry_date" property="entryDate" />
		<result column="type_cd" property="typeCd" />
	</resultMap>
	<select id="selectMilestoneList" resultType="MilestoneVO">
		select * from milestone 
		where prj_id=#{id}
	</select>

	<select id="selectMilestoneIssueList" resultMap="MilestoneIssueResultMap">
		select i.id id,
		i.milestone_id,
		GET_ISSID_TO_NAME(i.issue_id) name,
		i.issue_id issue_id,
		t.id timeline_id,
		t.contents contents,
		t.entry_date entry_date,
		t.type_cd type_cd
		from milestone_issue i
		left join milestone_timeline t
		on t.milestone_issue_id = i.id
		join milestone m
		on m.id=i.milestone_id
		where i.milestone_id=#{id}
	</select>
	<insert id="insertMilestone">
		<selectKey keyProperty="id" resultType="long" order="BEFORE">
			SELECT ISS_SEQ.NEXTVAL FROM DUAL
		</selectKey>
		insert into milestone (id, prj_id, name, start_date, end_date)
		values (${id}, #{prjId}, #{name}, #{startDate}, #{endDate})
	</insert>




</mapper>
